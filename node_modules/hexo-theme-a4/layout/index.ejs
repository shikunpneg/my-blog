<!-- ===== 首页自定义布局 ===== -->
<div id="home-layout">

  <!-- 右上角：站名 -->
  <div id="site-brand">
    <a href="<%- url_for() %>"><%= config.title %></a>
  </div>

  <!-- 侧边栏切换按钮 -->
  <button id="sidebar-toggle" title="切换侧边栏">☰</button>

  <!-- 主体区域 -->
  <div id="home-body">

    <!-- 左侧：分类导航侧边栏 -->
    <aside id="home-sidebar">
      <h3>分类</h3>
      <ul>
        <% if(site.categories && site.categories.length) { %>
          <% site.categories.forEach(function(cat){ %>
            <li><a href="<%- url_for(cat.path) %>"><%= cat.name %></a></li>
          <% }); %>
        <% } %>
      </ul>
      <!-- 在侧边栏底部显示所有页面链接（菜单） -->
      <h3 style="margin-top:2em;">导航</h3>
      <ul class="menu-vertical">
        <% 
        // 显式定义菜单顺序，保证 "其他" 在最后
        var menuOrder = ['首页','动态','读书笔记','写作','技术文章','论文','CV','我所爱的一切','其他'];
        for (var mIdx = 0; mIdx < menuOrder.length; mIdx++) {
          var name = menuOrder[mIdx];
          var link = theme.menu[name];
          if (!link) continue;
          if (typeof link === 'object' && link !== null) {
        %>
            <li class="dropdown-vertical">
              <a href="javascript:void(0)"><%= name %> ▾</a>
              <ul class="submenu-vertical">
                <% for (const [subName, subLink] of Object.entries(link)) { %>
                  <li><a href="<%- url_for(subLink) %>"><%= subName %></a></li>
                <% } %>
              </ul>
            </li>
          <% } else { %>
            <li><a href="<%- url_for(link) %>"><%= name %></a></li>
          <% } %>
        <% } %>
      </ul>
    </aside>

    <!-- 右侧：主要内容 -->
    <main id="home-main">

      <!-- 1. 自我介绍 -->
      <section id="intro-section">
        <p class="intro-cn">一个尚未成功的梦想家，一个厌恶一切的坏分子，是一个人。</p>
        <p class="intro-en">A dreamer who has not yet succeeded, a miscreant who hates everything, just a human being.</p>
      </section>

      <!-- 2. 电影图片 + 台词 -->
      <section id="movie-section">
        <div class="movie-poster">
          <img src="<%- url_for('/images/牯岭街.jpg') %>" alt="牯岭街少年杀人事件" />
        </div>
        <div class="movie-quote">
          <div class="quote-column">
            <span class="quote-speaker">小四</span>
            <p class="quote-text">"……因为只有我知道，只有我能够帮你，我是你现在唯一的希望了……"</p>
          </div>
          <div class="quote-column">
            <span class="quote-speaker">小明</span>
            <p class="quote-text">"你的意思是，你要帮助我来改变我，是不是？你怎么跟别人一样，我看错你了。你跟以前对我好的人一样，对我好就是要跟我交换我对你的感情。这样你就安全了，你太自私了。要改变我？我就跟这个世界一样，这个世界是不会变的，你以为你是谁啊？"</p>
          </div>
        </div>
      </section>

      <!-- 2.5 音频按钮 -->
      <section id="audio-section">
        <button id="audio-toggle">▶ 播放</button>
        <div id="audio-player" style="display:none;">
          <audio id="bgm" preload="none">
            <source src="<%- url_for('/MP3/Aliosha - 牯岭街少年杀人事件.mp3') %>" type="audio/mpeg">
          </audio>
        </div>
        <p class="audio-source">来自网易云 Ailosha</p>
      </section>

      <script>
      (function() {
        var btn = document.getElementById('audio-toggle');
        if (!btn) return;
        var audio = document.getElementById('bgm');
        var playing = false;
        btn.addEventListener('click', function() {
          if (playing) {
            audio.pause();
            btn.textContent = '▶ 播放';
            playing = false;
          } else {
            audio.play().then(function() {
              btn.textContent = '⏸ 暂停';
              playing = true;
            }).catch(function(e) {});
          }
        });
        if (audio) {
          audio.addEventListener('ended', function() {
            btn.textContent = '▶ 播放';
            playing = false;
          });
        }
      })();
      </script>

      <!-- 3. 近期动态 -->
      <section id="recent-posts-section">
        <h2>近期动态</h2>
        <div id="recent-posts-list">
          <% if(site.posts && site.posts.length) { %>
            <% var posts = site.posts.data; %>
            <% for(var i = 0; i < Math.min(posts.length, 10); i++) { %>
              <div class="recent-post-item">
                <span class="recent-post-date"><%= date(posts[i].date, "MM-DD") %></span>
                <a href="<%- url_for(posts[i].path) %>"><%= posts[i].title %></a>
              </div>
            <% } %>
          <% } else { %>
            <p><em>暂无文章</em></p>
          <% } %>
        </div>
      </section>

      <!-- 4. 友情链接 -->
      <section id="friends-section">
        <h2>友情链接</h2>
        <div class="friend-links">
          <a href="https://www.sickbaby.org/" target="_blank" rel="noopener">病孩子 sickbaby</a>
        </div>
      </section>

    </main>
  </div>
</div>

<script>
(function() {
  // 侧边栏切换
  var toggle = document.getElementById('sidebar-toggle');
  var sidebar = document.getElementById('home-sidebar');
  var body = document.getElementById('home-body');
  if(toggle && sidebar) {
    toggle.addEventListener('click', function() {
      sidebar.classList.toggle('hidden');
      body.classList.toggle('sidebar-hidden');
    });
  }
  // 侧边栏内下拉菜单点击切换
  document.querySelectorAll('.dropdown-vertical > a').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var li = this.parentElement;
      li.classList.toggle('open');
    });
  });
})();
</script>