<div class="post-main">
    <div class="post-md">
        <%
        var isCategory404 = (typeof path !== 'undefined' && path.indexOf('categories/') === 0);
        %>
        <% if(isCategory404) { %>
            <h2 style="text-align:center; color:#888; font-weight:300;">—— 过段时间再来看看！——</h2>
            <br>
            <div style="text-align: center; color:#666; font-size:0.9em;">
                <p>这个分类下还没有文章</p>
                <br>
                <a href="/" style="color:#999;">← 返回首页</a>
            </div>
        <% } else { %>
            <h2>Page not found.</h2>
            <br>
            <div style="text-align: center;">
                <% if(theme.index.header != null || theme.index.header == "") {%>
                    <div class="index-header-line" >
                        <% if(theme.index.hitokoto) { %>
                            <span id="quote" style="font-size: large;"></span>
                            <script src="<%= url_for('/js/hitokoto.js') %>" ></script>
                        <% } else { %>
                            <div id="hiddenHeaderContentArray" style="display: none;">
                                <% var headerContentArray = theme.index.header %>
                                <% var headerContentArrayLength = headerContentArray.length %>
                                <% for(let i = 0; i < headerContentArrayLength; i++) { %>
                                    <span><%= theme.index.header[i] %></span>
                                <% } %>
                            </div>
                            <span id="targetSpan" style="font-size: large;"></span>
                        <% } %>
                    </div>
                <% } %>
                <a href="/">Go Back Home</a>
            </div>
        <% } %>
    </div>
</div>
